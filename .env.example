# --- Veri toplama (npm run topla) ---
BRIGHTDATA_API_KEY=
# Tahmini maliyet bunu aşarsa --onay ister (USD)
TOPLA_BUTCE_UYARI_USD=5

# --- Site ---
# Veri klasörü (yoksa ornek-veri/ kullanılır)
REHBER_DATA_DIR=data
# Form talepleri (eşleştirme, kaldırma) bu klasöre yazılır
REHBER_TALEP_DIR=talepler
# Yayın ucu jetonu (uzaktan veri yükleme). Boşsa uç kapalıdır (503).
REHBER_YAYIN_TOKEN=

# --- Siteyi işleten (boş alan sayfada gösterilmez) ---
NEXT_PUBLIC_SITE_NAME=Influencer Rehberi
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CTA_URL=
NEXT_PUBLIC_REPO_URL=https://github.com/aytacvelipamuk/influencer-rehberi
# Kendi hero videonuz (public/ altına koyun ya da tam adres)
NEXT_PUBLIC_HERO_VIDEO=
NEXT_PUBLIC_HERO_POSTER=
